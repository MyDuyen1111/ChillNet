# ChillNet — biến môi trường (FILE MẪU)
# Cách dùng:  cp .env.example .env  rồi điền giá trị vào .env
# scripts/run-all.sh sẽ TỰ NẠP .env khi chạy. KHÔNG commit .env (đã bị .gitignore vì chứa secret).

# ===================== BẮT BUỘC =====================
# Khóa ký JWT (HS512). identity-service KHÔNG có default — thiếu là cả hệ thống không chạy.
# Tạo nhanh:  openssl rand -base64 48
JWT_SIGNER_KEY=

# ===================== AI — Kiểm duyệt nội dung (ai-service) =====================
# Endpoint OpenAI-compatible. Nếu dùng OpenAI thật thì để nguyên base-url mặc định.
# Nếu dùng proxy/endpoint riêng của bạn thì đổi OPENAI_BASE_URL cho khớp (giữ phần /v1 nếu có).
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_MS=15000

# ===================== PORTS (local development defaults) =====================
# Các script, Spring services, Vite và Docker Compose đều đọc các biến này.
FRONTEND_PORT=5174
API_GATEWAY_PORT=8080
IDENTITY_SERVICE_PORT=8081
PROFILE_SERVICE_PORT=8082
NOTIFICATION_SERVICE_PORT=8083
POST_SERVICE_PORT=8084
FILE_SERVICE_PORT=8085
CHAT_SERVICE_PORT=8086
SOCIAL_SERVICE_PORT=8087
INTERACTION_SERVICE_PORT=8088
GROUP_SERVICE_PORT=8089
AI_SERVICE_PORT=8090
MODERATION_SERVICE_PORT=8091
MYSQL_PORT=3306
MONGODB_PORT=27018
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===================== TÙY CHỌN (thiếu thì tính năng đó tắt, service vẫn khởi động) =====================
# QUAN TRỌNG: giữ dạng comment (#) nếu chưa dùng. ĐỪNG để "VAR=" rỗng — run-all.sh export cả
# biến rỗng, ghi đè default trong yaml và làm Google OAuth2 chết ("Client id must not be empty").
# Bật tính năng nào thì bỏ # và điền giá trị.
# Google OAuth2 login (identity-service)
# CLIENT_ID=
# CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# MinIO — lưu ảnh (file-service). Default trong application.yaml đã khớp
# docker-compose.infra.yml, chỉ cần set khi chạy MinIO ở nơi khác.
# MINIO_ENDPOINT=
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# MINIO_BUCKET=
# MINIO_PUBLIC_URL=

# Brevo — gửi email OTP/thông báo (notification-service)
# BREVO_APIKEY=

# ===================== HẠ TẦNG (đã có default cho local, chỉ set nếu muốn đổi) =====================
# MySQL (identity/profile/social/interaction)
# DBMS_CONNECTION=jdbc:mysql://localhost:3306/interaction_service?createDatabaseIfNotExist=true
# DBMS_USERNAME=root
# DBMS_PASSWORD=814362
# MongoDB (notification/post/file/chat/group) — mặc định dùng MONGODB_PORT ở trên.
# MONGODB_URI=mongodb://root:814362@localhost:27018/post-service?authSource=admin

# ===================== MÁY CỤC BỘ (tùy chọn) =====================
# Nếu máy không có Java hệ thống, trỏ JAVA_HOME tới JDK portable — run-all.sh sẽ tự thêm vào PATH.
# JAVA_HOME=/home/ban/tools/jdk17
